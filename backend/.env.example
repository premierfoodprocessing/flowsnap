# Optional JavaScript runtime for YouTube extraction.
FLOWSNAP_DENO_PATH=/absolute/path/to/deno

# Permit yt-dlp to retrieve current EJS components.
FLOWSNAP_ENABLE_REMOTE_EJS=false

# Local development only. Leave unset in production.
# Close Chromium before FlowSnap extracts cookies.
FLOWSNAP_COOKIE_BROWSER=chromium
FLOWSNAP_COOKIE_PROFILE=/absolute/path/to/chromium/profile
